# Neo4j 连接（Domain KG + Patient KG 共用单实例）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# 危机通知收件人（T6 guard 使用）
CAREGIVER_EMAIL=caregiver@example.com
COMMUNITY_DOCTOR_EMAIL=doctor@example.com

# SMTP（异步邮件通知，T6 使用）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=